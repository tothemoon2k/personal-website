---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title="Essays — Justin Garner">
  <h1>Essays</h1>
  <ul class="essay-list">
    {essays.map((essay) => (
      <li>
        <a href={`/essays/${essay.id}`}>{essay.data.title}</a>
        <span class="date">{fmt.format(essay.data.date)}</span>
      </li>
    ))}
  </ul>
</Layout>
