---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
};

const { essay } = Astro.props;
const { Content } = await render(essay);

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={`${essay.data.title} — Justin Garner`} description={essay.data.description}>
  <article>
    <h1>{essay.data.title}</h1>
    <p class="post-meta">{fmt.format(essay.data.date)}</p>
    <Content />
  </article>
</Layout>
