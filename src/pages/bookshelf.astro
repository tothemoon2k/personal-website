---
import Layout from '../layouts/Layout.astro';

const books = [
  { title: 'Elon Musk', author: 'Walter Isaacson', url: 'https://www.amazon.com/Elon-Musk-Walter-Isaacson/dp/1982181281' },
  { title: "The CEO's Secret Weapon", author: 'Jan Jones', url: 'https://www.amazon.com/CEOs-Secret-Weapon-Productivity-Effectiveness/dp/1137444231' },
  { title: 'Isaac Newton', author: 'James Gleick', url: 'https://www.amazon.com/Isaac-Newton-James-Gleick/dp/1400032954' },
  { title: 'The Book of Elon', author: 'Eric Jorgenson', url: 'https://www.amazon.com/Book-Elon-Guide-Purpose-Success/dp/154455074X' },
  { title: "Don't Make Me Think", author: 'Steve Krug', url: 'https://www.amazon.com/Dont-Make-Think-Revisited-Usability/dp/0321965515' },
  { title: 'Outliers', author: 'Malcolm Gladwell', url: 'https://www.amazon.com/Outliers-Story-Success-Malcolm-Gladwell/dp/0316017930' },
  { title: 'Letters From a Stoic', author: 'Seneca', url: 'https://www.amazon.com/Letters-Penguin-Classics-Lucius-Annaeus/dp/0140442103' },
  { title: 'Meditations', author: 'Marcus Aurelius', url: 'https://www.amazon.com/Meditations-New-Translation-Marcus-Aurelius/dp/0812968255' },
  { title: 'How to Read a Book', author: 'Mortimer J. Adler and Charles Van Doren', url: 'https://www.amazon.com/How-Read-Book-Classic-Intelligent/dp/0671212095' },
  { title: 'The Almanack of Naval Ravikant', author: 'Eric Jorgenson', url: 'https://www.amazon.com/Almanack-Naval-Ravikant-Wealth-Happiness/dp/1544514212' },
  { title: 'The Mom Test', author: 'Rob Fitzpatrick', url: 'https://www.amazon.com/Mom-Test-customers-business-everyone/dp/1492180742' },
  { title: 'The Algorithm', author: 'Jon McNeill', url: 'https://www.amazon.com/Algorithm-Hypergrowth-Formula-Transformed-Lululemon/dp/B0FFG5KFSK' },
  { title: 'Liftoff', author: 'Eric Berger', url: 'https://www.amazon.com/Liftoff-Desperate-Early-Launched-SpaceX/dp/0062979981' },
  { title: 'The ONE Thing', author: 'Gary Keller and Jay Papasan', url: 'https://www.amazon.com/ONE-Thing-Surprisingly-Extraordinary-Results/dp/1885167776' },
  { title: 'The Goal', author: 'Eliyahu M. Goldratt and Jeff Cox', url: 'https://www.amazon.com/Goal-Process-Ongoing-Improvement/dp/0884271951' },
  { title: 'Working Backwards', author: 'Colin Bryar and Bill Carr', url: 'https://www.amazon.com/Working-Backwards-Insights-Stories-Secrets/dp/1250267595' },
  { title: 'The General and the Genius', author: 'James Kunetka', url: 'https://www.amazon.com/General-Genius-Oppenheimer-Unlikely-Partnership/dp/1621573389' },
  { title: 'Napoleon', author: 'David A. Bell', url: 'https://www.amazon.com/Napoleon-Concise-Biography-David-Bell/dp/0190262710' },
  { title: 'Confessions of an Advertising Man', author: 'David Ogilvy', url: 'https://www.amazon.com/Confessions-Advertising-Man-David-Ogilvy/dp/0689706014' },
  { title: 'The Man Who Knew Infinity', author: 'Robert Kanigel', url: 'https://www.amazon.com/Man-Who-Knew-Infinity-Ramanujan/dp/1476763496' },
  { title: "The Accountant's Story", author: 'Roberto Escobar and David Fisher', url: 'https://www.amazon.com/Accountants-Story-Inside-Violent-Medell%C3%ADn/dp/0446178926' },
  { title: 'Lying', author: 'Sam Harris', url: 'https://www.amazon.com/Lying-Sam-Harris/dp/1940051002' },
];
---

<Layout title="Bookshelf — Justin Garner">
  <h1>Bookshelf</h1>
  <p>Books I've read and recommend. I try to keep this list up to date.</p>
  <ul>
    {books.map((book) => (
      <li>
        <a href={book.url} target="_blank" rel="noopener">
          <em>{book.title}</em>
        </a>
        {' by '}{book.author}
      </li>
    ))}
  </ul>
</Layout>
