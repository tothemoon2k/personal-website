---
const { pathname } = Astro.url;
const links = [
  { href: '/about', label: 'About' },
  { href: '/essays', label: 'Essays' },
  { href: '/bookshelf', label: 'Bookshelf' },
];
---

<nav class="top-nav">
  <span>Justin Garner</span>
  {links.map(({ href, label }) => (
    <a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>{label}</a>
  ))}
</nav>
